+func validateNoForkProviderGlobalConfig(d *schema.ResourceData) error {
+	unsupported := []string{}
+	if tags := IgnoreDefinedTags(d); len(tags) != 0 {
+		unsupported = append(unsupported, globalvar.DefinedTagsToIgnore)
