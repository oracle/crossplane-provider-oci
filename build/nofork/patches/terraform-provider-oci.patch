+)
+
+func TestOracleClientsConfigureBaseClientIsolation(t *testing.T) {
+	var firstCalls atomic.Int64
+	var secondCalls atomic.Int64
+
+	first := &OracleClients{ConfigureClient: func(*oci_common.BaseClient) error {
+		firstCalls.Add(1)
+		return nil
+	}}
+	second := &OracleClients{ConfigureClient: func(*oci_common.BaseClient) error {
+		secondCalls.Add(1)
+		return nil
+	}}
+
+	const calls = 100
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for range calls {
+			if err := first.ConfigureBaseClient(&oci_common.BaseClient{}); err != nil {
+				t.Errorf("first ConfigureBaseClient returned error: %v", err)
+				return
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for range calls {
+			if err := second.ConfigureBaseClient(&oci_common.BaseClient{}); err != nil {
+				t.Errorf("second ConfigureBaseClient returned error: %v", err)
+				return
+			}
+		}
+	}()
+	wg.Wait()
+
+	if got := firstCalls.Load(); got != calls {
+		t.Fatalf("first callback calls = %d, want %d", got, calls)
+	}
+	if got := secondCalls.Load(); got != calls {
+		t.Fatalf("second callback calls = %d, want %d", got, calls)
+	}
+}
+
+func TestOracleClientsConfigureBaseClientRequiresCallback(t *testing.T) {
+	if err := (&OracleClients{}).ConfigureBaseClient(&oci_common.BaseClient{}); err == nil {
+		t.Fatal("ConfigureBaseClient returned nil error without a callback")
+	}
+}
+
+func TestEndpointSpecificClientsUseInstanceCallback(t *testing.T) {
+	first := newEndpointTestClients(t, "first-provider-config")
+	second := newEndpointTestClients(t, "second-provider-config")
+
+	testCases := []struct {
+		name   string
+		create func(*OracleClients) (*oci_common.BaseClient, error)
+	}{
+		{
+			name: "Functions",
+			create: func(clients *OracleClients) (*oci_common.BaseClient, error) {
+				client, err := clients.FunctionsInvokeClientWithEndpoint("https://functions.example.com")
+				return &client.BaseClient, err
+			},
+		},
+		{
+			name: "KMS crypto",
+			create: func(clients *OracleClients) (*oci_common.BaseClient, error) {
+				client, err := clients.KmsCryptoClientWithEndpoint("https://kms-crypto.example.com")
+				return &client.BaseClient, err
+			},
+		},
+		{
+			name: "KMS management",
+			create: func(clients *OracleClients) (*oci_common.BaseClient, error) {
+				client, err := clients.KmsManagementClientWithEndpoint("https://kms-management.example.com")
+				return &client.BaseClient, err
+			},
+		},
+		{
+			name: "Identity Domains",
+			create: func(clients *OracleClients) (*oci_common.BaseClient, error) {
+				client, err := clients.IdentityDomainsClientWithEndpoint("https://identity-domains.example.com")
+				return &client.BaseClient, err
+			},
+		},
+	}
+
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			var firstClient *oci_common.BaseClient
+			var secondClient *oci_common.BaseClient
+			var firstErr error
+			var secondErr error
+
+			var wg sync.WaitGroup
+			wg.Add(2)
+			go func() {
+				defer wg.Done()
+				firstClient, firstErr = testCase.create(first)
+			}()
+			go func() {
+				defer wg.Done()
+				secondClient, secondErr = testCase.create(second)
+			}()
+			wg.Wait()
+
+			if firstErr != nil {
+				t.Fatalf("first client creation returned error: %v", firstErr)
+			}
+			if secondErr != nil {
+				t.Fatalf("second client creation returned error: %v", secondErr)
+			}
+			if got := firstClient.UserAgent; got != "first-provider-config" {
+				t.Fatalf("first client user agent = %q, want first ProviderConfig callback", got)
+			}
+			if got := secondClient.UserAgent; got != "second-provider-config" {
+				t.Fatalf("second client user agent = %q, want second ProviderConfig callback", got)
+			}
+		})
+	}
+}
+
+func newEndpointTestClients(t *testing.T, userAgent string) *OracleClients {
+	t.Helper()
+	privateKey, err := rsa.GenerateKey(rand.Reader, 1024)
+	if err != nil {
+		t.Fatalf("generate test private key: %v", err)
+	}
+	configProvider := endpointTestConfiguration{privateKey: privateKey}
+
+	functionsClient, err := oci_functions.NewFunctionsInvokeClientWithConfigurationProvider(configProvider, "https://functions-primary.example.com")
+	if err != nil {
+		t.Fatalf("create primary Functions client: %v", err)
+	}
+	kmsCryptoClient, err := oci_kms.NewKmsCryptoClientWithConfigurationProvider(configProvider, "https://kms-crypto-primary.example.com")
+	if err != nil {
+		t.Fatalf("create primary KMS crypto client: %v", err)
+	}
+	kmsManagementClient, err := oci_kms.NewKmsManagementClientWithConfigurationProvider(configProvider, "https://kms-management-primary.example.com")
+	if err != nil {
+		t.Fatalf("create primary KMS management client: %v", err)
+	}
+	identityDomainsClient, err := oci_identity_domains.NewIdentityDomainsClientWithConfigurationProvider(configProvider, "https://identity-domains-primary.example.com")
+	if err != nil {
+		t.Fatalf("create primary Identity Domains client: %v", err)
+	}
+
+	return &OracleClients{
+		SdkClientMap: map[string]interface{}{
+			"oci_functions.FunctionsInvokeClient":        &functionsClient,
+			"oci_kms.KmsCryptoClient":                    &kmsCryptoClient,
+			"oci_kms.KmsManagementClient":                &kmsManagementClient,
+			"oci_identity_domains.IdentityDomainsClient": &identityDomainsClient,
+		},
+		ConfigureClient: func(client *oci_common.BaseClient) error {
+			client.UserAgent = userAgent
+			return nil
+		},
+	}
+}
+
+type endpointTestConfiguration struct {
+	privateKey *rsa.PrivateKey
+}
+
+func (c endpointTestConfiguration) PrivateRSAKey() (*rsa.PrivateKey, error) {
+	return c.privateKey, nil
+}
+
+func (endpointTestConfiguration) KeyID() (string, error) {
+	return "tenancy/user/fingerprint", nil
+}
+
+func (endpointTestConfiguration) TenancyOCID() (string, error) {
+	return "tenancy", nil
+}
+
+func (endpointTestConfiguration) UserOCID() (string, error) {
+	return "user", nil
+}
+
+func (endpointTestConfiguration) KeyFingerprint() (string, error) {
+	return "fingerprint", nil
+}
+
+func (endpointTestConfiguration) Region() (string, error) {
+	return "us-ashburn-1", nil
+}
+
+func (endpointTestConfiguration) AuthType() (oci_common.AuthConfig, error) {
+	return oci_common.AuthConfig{AuthType: oci_common.UserPrincipal}, nil
+}
